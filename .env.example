# AgentOps configuration. Copy to .env; every value has a working default for local use.

# --- Secrets (change for anything that is not a local demo) ---
SECRET_KEY=                      # encrypts provider keys saved from the UI. Set a long random value;
                                 # the built-in default is public and only suitable for a local demo
POSTGRES_PASSWORD=postgres
AGENTOPS_OWNER_PASSWORD=agentops_owner
AGENTOPS_APP_PASSWORD=agentops_app

# --- Accounts ---
SEED_DEMO=true                   # create the two demo organisations, six demo users and the demo data
DEMO_SCALE=0.25            # share of the 2-million-span demo data set generated at first start
COOKIE_SECURE=false              # true behind HTTPS
ALLOW_SIGNUP=true                # false to stop new organisations signing up
CORS_ORIGINS=http://localhost:3200

# --- LLM (see docs/PROVIDERS.md for every provider) ---
LLM_PROVIDER=stub                # openai_compat | anthropic | ollama | stub
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_PRICE_INPUT_PER_MTOK=3.0     # USD per million tokens, used for cost estimates and budgets
LLM_PRICE_OUTPUT_PER_MTOK=15.0
ALLOW_PRIVATE_LLM_URLS=true      # false on a shared deployment (blocks base URLs on private networks)
ALLOW_PRIVATE_TARGETS=true       # false on a shared deployment (experiments may only call public addresses)

# --- Agent budgets ---
RUN_MAX_STEPS=25
RUN_MAX_TOKENS=200000
RUN_MAX_SECONDS=300
RUN_MAX_COST_USD=1.00
ORG_DAILY_COST_USD=20.00
GLOBAL_DAILY_COST_USD=200.00     # all organisations together
ORG_MAX_CONCURRENT_RUNS=5
ORG_MAX_QUEUED_RUNS=15           # runs waiting beyond the concurrent limit before new ones get 429

# --- Evaluation ---
JUDGE_MIN_LABELS=20              # human grades a judge needs before it counts as calibrated
JUDGE_MIN_KAPPA=0.6              # agreement (Cohen's kappa) it must reach with them
GATE_MIN_GRADED=20               # items the primary evaluator must grade before a release can pass the gate
EXPERIMENT_MAX_ITEMS=2000
EXPERIMENT_MAX_COST_USD=5.00

# --- Network ---
WEB_BIND=127.0.0.1               # address the UI is published on; 0.0.0.0 only behind a firewall you control
# WEB_INGEST_BIND=172.17.0.1      # Docker bridge gateway (docker network inspect bridge): lets other projects'
#                                  # containers send traces to host.docker.internal:3200. Not reachable from the LAN.

# --- Ingestion and monitoring ---
INGEST_REQUESTS_PER_MINUTE=600   # per ingestion key
METRICS_TOKEN=                   # when set, /metrics requires "Authorization: Bearer <token>"

# --- Scale ---
WORKER_CONCURRENCY=4
INGEST_CONCURRENCY=4       # batches each ingest container writes at once
OTEL_EXPORTER_OTLP_ENDPOINT=     # set to export traces, e.g. http://localhost:4318
